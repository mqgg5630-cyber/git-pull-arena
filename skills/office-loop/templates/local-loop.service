# local-loop.service - run the machine-side watcher once per timer tick.
# Install (Linux, per user - no root needed):
#   mkdir -p ~/.config/systemd/user
#   cp skills/office-loop/templates/local-loop.* ~/.config/systemd/user/
#   # edit ExecStart to your repo path, then:
#   systemctl --user daemon-reload && systemctl --user enable --now local-loop.timer
#   journalctl --user -u local-loop.service -f     # watch it work
[Unit]
Description=git-sync local loop (pull request, run code/local_check.sh, push verdict)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/REPO-PATH
ExecStart=/usr/bin/env bash code/watch-linux.sh --once
TimeoutStartSec=2400
Nice=10
